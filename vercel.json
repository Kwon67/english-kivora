{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/cron/daily-plan",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/due-review-notifications",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/streak-reminder",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/evaluate-medals",
      "schedule": "0 6 * * *"
    }
  ]
}
