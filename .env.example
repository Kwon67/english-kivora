# Supabase public browser config. These two are intentionally public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://english-kivora.vercel.app

# Supabase server-only secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side application secrets.
ADMIN_SECRET=
# Dedicated key for temporary signup password encryption (preferred over reusing service role).
# Generate with: openssl rand -base64 32
SIGNUP_PASSWORD_ENCRYPTION_KEY=
CRON_SECRET=
GROQ_API_KEY=
UNSPLASH_ACCESS_KEY=
RESEND_API_KEY=

# --- Email: modo atual (sem domínio comprado) ---
# Envia só para o email da conta Resend. Bom para testar cadastro localmente.
RESEND_SANDBOX_MODE=true
RESEND_SANDBOX_TO=

# --- Email: modo produção (depois de comprar e verificar o domínio no Resend) ---
# 1. Verifique o domínio em https://resend.com/domains
# 2. Preencha KIVORA_EMAIL_DOMAIN com o domínio comprado (ex.: kivora.com)
# 3. No Vercel: RESEND_SANDBOX_MODE=false
# KIVORA_EMAIL_DOMAIN=
# KIVORA_EMAIL_FROM_LOCAL_PART=noreply
# KIVORA_EMAIL_FROM_NAME=Kivora English
# Opcional: sobrescreve o remetente montado automaticamente acima
# RESEND_FROM=Kivora English <noreply@seudominio.com>

# Cloudinary delivery for generated pack covers.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Web Push / PWA notifications.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=kivora.dev@outlook.com
VAPID_SUBJECT=mailto:kivora.dev@outlook.com

# Optional local speech worker config.
SPEECH_WORKER_URL=http://localhost:8000
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_SIZE_MB=8
SPEECH_WORKER_TIMEOUT_MS=30000

# Optional visual editor / deployment integrations.
NEXT_PUBLIC_BUILDER_API_KEY=
