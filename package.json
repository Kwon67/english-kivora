{
  "name": "kivora-english",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "Chrome >= 111",
    "Firefox >= 128",
    "Safari >= 16",
    "iOS >= 16"
  ],
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:ts6": "tsc --noEmit",
    "audit:colors": "node scripts/audit-colors.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "diagnose:resend": "node scripts/diagnose-resend.mjs",
    "test": "vitest run",
    "test:e2e": "set -a && . ./.env.e2e && set +a && playwright test",
    "test:e2e:headed": "set -a && . ./.env.e2e && set +a && playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "db:blitz": "node scripts/apply-blitz-migration.mjs",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "audit:catalog": "tsx scripts/audit-catalog.ts",
    "audit:rls": "tsx scripts/audit-rls.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "^1.0.12",
    "@rive-app/canvas": "^2.50.0",
    "@supabase/auth-js": "2.119.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@use-gesture/react": "^10.3.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "locomotive-scroll": "^5.1.1",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.71.0",
    "motion": "^13.5.1",
    "next": "^16.4.6",
    "node-edge-tts": "^1.2.12",
    "posthog-js": "^1.447.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.1",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
