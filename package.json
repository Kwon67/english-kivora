{
  "name": "kivora-english",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "Chrome >= 111",
    "Firefox >= 128",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ],
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:ts6": "node node_modules/typescript/bin/tsc --noEmit",
    "audit:colors": "node scripts/audit-colors.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "diagnose:resend": "node scripts/diagnose-resend.mjs",
    "test": "vitest run",
    "test:e2e": "set -a && . ./.env.e2e && set +a && playwright test",
    "test:e2e:headed": "set -a && . ./.env.e2e && set +a && playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "db:blitz": "node scripts/apply-blitz-migration.mjs",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "audit:catalog": "tsx scripts/audit-catalog.ts",
    "audit:rls": "tsx scripts/audit-rls.ts",
    "test:visual": "playwright test -c tests/visual/playwright.config.ts",
    "optimize:models": "node scripts/optimize-models.mjs",
    "audit:landing-palette": "playwright test -c tests/visual/playwright.config.ts -g paleta",
    "measure:landing-js": "node scripts/measure-landing-bundle.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@lottiefiles/dotlottie-react": "^0.22.3",
    "@lottiefiles/dotlottie-web": "0.83.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "@rive-app/canvas": "^2.51.0",
    "@rive-app/react-canvas": "^4.39.0",
    "@sanity/client": "8.16.0",
    "@sanity/image-url": "^2.2.0",
    "@splinetool/react-spline": "^4.2.0",
    "@splinetool/runtime": "^2.0.196",
    "@supabase/auth-js": "2.119.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@theatre/core": "^0.7.2",
    "@theatre/r3f": "^0.7.2",
    "@use-gesture/react": "^10.3.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "draco3dgltf": "^1.5.9",
    "gsap": "^3.15.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "lenis": "1.3.27",
    "leva": "^0.10.1",
    "lucide-react": "^1.75.0",
    "meshoptimizer": "^1.3.0",
    "next": "^16.4.6",
    "posthog-js": "^1.450.1",
    "postprocessing": "^6.39.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.16",
    "react-is": "19.3.1",
    "recharts": "^3.11.0",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^3.7.0",
    "three": "~0.187.0",
    "ts-fsrs": "^6.0.0",
    "unicornstudio": "^2.6.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@theatre/studio": "^0.7.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "~0.187.0",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "supabase": "3.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
