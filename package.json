{
  "name": "kivora-english",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "Chrome >= 111",
    "Firefox >= 128",
    "Safari >= 16",
    "iOS >= 16"
  ],
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "postinstall": "patch-package",
    "typecheck": "node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:ts6": "tsc --noEmit",
    "audit:colors": "node scripts/audit-colors.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "diagnose:resend": "node scripts/diagnose-resend.mjs",
    "test": "vitest run",
    "test:e2e": "set -a && . ./.env.e2e && set +a && playwright test",
    "test:e2e:headed": "set -a && . ./.env.e2e && set +a && playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "db:blitz": "node scripts/apply-blitz-migration.mjs",
    "seed:catalog": "npx tsx scripts/seed-catalog.ts",
    "audit:catalog": "npx tsx scripts/audit-catalog.ts",
    "audit:rls": "npx tsx scripts/audit-rls.ts"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^1.0.12",
    "@supabase/auth-js": "^2.112.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@use-gesture/react": "^10.3.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lottie-react": "^3.1.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "node-edge-tts": "^1.2.10",
    "posthog-js": "^1.418.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.3",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "postcss": "^8.5.26",
    "tar": "^7.5.22"
  }
}
